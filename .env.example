# Copy this file to .env and replace the placeholders for your chosen setup.
# Local Python + PostgreSQL: use your local application login's password.
# Examples of URL encoding: @ becomes %40, and / becomes %2F.
DATABASE_URL=postgresql+psycopg://issue_tracker_user:YOUR_URL_ENCODED_PASSWORD@localhost:5432/issue_tracker

# Docker Compose: choose a password for the container's PostgreSQL login.
# Use the same password in both values: raw below, URL-encoded in the URL.
# Compose passes DOCKER_DATABASE_URL to the API container as DATABASE_URL.
POSTGRES_PASSWORD='CHANGE_ME'
DOCKER_DATABASE_URL='postgresql+psycopg://issue_tracker_user:CHANGE_ME@db:5432/issue_tracker'

# Local automated tests: .env.test needs only DATABASE_URL, with the local
# login password and database name issue_tracker_test instead of issue_tracker.
