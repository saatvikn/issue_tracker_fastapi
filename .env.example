# Copy this file to .env for local development.
# Replace the password placeholder with your URL-encoded application password.
# Examples of URL encoding: @ becomes %40, and / becomes %2F.
DATABASE_URL=postgresql+psycopg://issue_tracker_user:YOUR_URL_ENCODED_PASSWORD@localhost:5432/issue_tracker

# For automated tests, copy this file to .env.test and change the database name
# at the end of DATABASE_URL from issue_tracker to issue_tracker_test.
